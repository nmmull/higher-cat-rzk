#lang rzk-1

#def ∧ˡ (A : U) (B : U) : U := Σ (_ : A) , B

#data ∨ˡ (A : U) (B : U) : U :=
  left (a : A) : ∨ˡ A B
  | right (b : B) : ∨ˡ A B

#def cong
  (A B : U)
  (x y : A)
  (f : A → B)
  (eq : x = y)
  : f x = f y
  := idJ(A, x, \z _ → f x = f z, refl, y, eq)

#def sym
  (A : U)
  (x y : A)
  (x=y : x = y)
  : y = x
  := idJ(A, x, \z _ → z = x, refl, y, x=y)

#def trans
  (A : U)
  (x y z : A)
  (x=y : x = y)
  (y=z : y = z)
  : x = z
  := idJ(A, y, \q _ → x = q, x=y, z, y=z)

#data ℕ := 𝑍 | 𝑆 (n : ℕ)

#def + (m : ℕ) (n : ℕ) : ℕ :=
  match m
  ( 𝑍 ⇒ n
  | 𝑆 k k+n ⇒ 𝑆 k+n
  )

#def ⋆ (m : ℕ) (n : ℕ) : ℕ :=
  match m
  ( 𝑍 ⇒ 𝑍
  | 𝑆 k k⋆n ⇒ + n k⋆n
  )

#def ≤ⁿ (m : ℕ) (n : ℕ) : U :=
  match n
  ( 𝑍 ⇒ m = 𝑍
  | 𝑆 k m≤k-ty ⇒ ∨ˡ (m = 𝑆 k) m≤k-ty
  )

#def 𝑆-eq
  (m : ℕ)
  (n : ℕ)
  (m=n : m = n)
  : 𝑆 m = 𝑆 n
  := cong ℕ ℕ m n (\k → 𝑆 k) m=n

#def S-≤
  (m : ℕ)
  (n : ℕ)
  : ≤ⁿ m n → ≤ⁿ (𝑆 m) (𝑆 n)
  :=
  match n
  ( 𝑍 ⇒
    \m-eq-𝑍 →
      left
        (𝑆 m = 𝑆 𝑍)
        (≤ⁿ (𝑆 m) 𝑍)
        (𝑆-eq m 𝑍 m-eq-𝑍)
  | 𝑆 k m≤k→sm≤mk ⇒
    \m-≤ⁿ-sk →
      match m-≤ⁿ-sk
      ( left m-eq-sk ⇒
        left
          (𝑆 m = (𝑆 (𝑆 k)))
          (≤ⁿ (𝑆 m) (𝑆 k))
          (𝑆-eq m (𝑆 k) m-eq-sk)
      | right m≤k ⇒
        right
          (𝑆 m = (𝑆 (𝑆 k)))
          (≤ⁿ (𝑆 m) (𝑆 k))
          (m≤k→sm≤mk m≤k)
      )
  )

#def 𝑍≤n
  (n : ℕ)
  : ≤ⁿ 𝑍 n
  :=
  match n
  ( 𝑍 ⇒ refl
  | 𝑆 k 𝑍≤k ⇒
    right
      (𝑍 = 𝑆 k)
      (≤ⁿ 𝑍 k)
      𝑍≤k
  )

#def euclids-lemma
  (m : ℕ)
  (l : ℕ)
  : Σ (j : ℕ) , Σ (k : ℕ) , ∧ˡ (+ j (⋆ k (𝑆 m)) = l) (≤ⁿ j m)
  :=
  match l
  ( 𝑍 ⇒ (𝑍, (𝑍, (refl, 𝑍≤n m)))
  | 𝑆 n (j, (k, (j+k⋆𝑆m=n, j-≤ⁿ-m))) ⇒
    match (S-≤ j m j-≤ⁿ-m)
    ( left 𝑆-j=𝑆-m ⇒
      let 𝑆-m=𝑆-j := sym ℕ (𝑆 j) (𝑆 m) 𝑆-j=𝑆-m in
      let eq :=
        trans
          ℕ
          (+ (𝑆 m) (⋆ k (𝑆 m)))
          (+ (𝑆 j) (⋆ k (𝑆 m)))
          (𝑆 n)
          (cong
            ℕ
            ℕ
            (𝑆 m)
            (𝑆 j)
            (\z → + z (⋆ k (𝑆 m)))
            𝑆-m=𝑆-j)
          (𝑆-eq
            (+ j (⋆ k (𝑆 m)))
            n
            j+k⋆𝑆m=n)
      in (𝑍, (𝑆 k, (eq, 𝑍≤n m)))
    | right 𝑆-j-≤ⁿ-m ⇒
      let eq :=
        𝑆-eq
          (+ j (⋆ k (𝑆 m)))
          n
          j+k⋆𝑆m=n
      in (𝑆 j, (k, (eq, 𝑆-j-≤ⁿ-m)))
    )
  )
