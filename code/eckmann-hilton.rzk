#lang rzk-1

#def symm
  (A : U)
  (x y : A)
  (x=y : x = y)
  : y = x
  :=
  idJ
    (A
    , x
    , \z _ → z = x
    , refl
    , y
    , x=y
    )

#def trans
  (A : U)
  (x y z : A)
  (x=y : x = y)
  (y=z : y = z)
  : x = z
  :=
  idJ
    ( A
    , y
    , \w _ → x = w
    , x=y
    , z
    , y=z
    )

#def trans²
  (A : U)
  (a b c d : A)
  (p : a = b)
  (q : b = c)
  (r : c = d)
  : a = d
  := trans A a c d (trans A a b c p q) r

#def lu
  (A : U)
  (x y : A)
  (p : x = y)
  : p = trans A x x y refl p
  :=
  idJ
    ( A
    , x
    , \z q → q = trans A x x z refl q
    , refl
    , y
    , p
    )

#def ru
  (A : U)
  (x y : A)
  (p : x = y)
  : p = trans A x y y p refl
  :=
  idJ
    ( A
    , x
    , \z q → q = trans A x z z q refl
    , refl
    , y
    , p
    )

#def symm-symm
  (A : U)
  (x y : A)
  (p : x = y)
  : symm A y x (symm A x y p) = p
  :=
  idJ
    ( A
    , x
    , \z q → symm A z x (symm A x z q) = q
    , refl
    , y
    , p
    )


#def idJ²
  (A : U)
  (b : A)
  (D : (x : A) → (p : x = b) → U)
  (d : D b refl)
  (x : A)
  (p : x = b)
  : D x p
  :=
  let
    d-symm-symm
    : D x (symm A b x (symm A x b p))
    :=
    idJ
      ( A
      , b
      , \z q → D z (symm A b z q)
      , d
      , x
      , symm A x b p
      )
  in
  idJ
    ( x = b
    , symm A b x (symm A x b p)
    , \q _ → D x q
    , d-symm-symm
    , p
    , symm-symm A x b p
    )

#def Ω
  (A : U)
  (a : A)
  : U
  := a = a

#def Ω²
  (A : U)
  (a : A)
  : U
  := refl =_{a = a} refl

#def whisker-r
  (A : U)
  (a b c : A)
  (p q : a = b)
  (α : p = q)
  (r : b = c)
  : trans A a b c p r = trans A a b c q r
  -- p ■ r = q ■ r
  :=
  let ■ := trans A a b b in
  let eq1
    : ■ p refl = p
    := symm (a = b) p (■ p refl) (ru A a b p)
  in
  let eq2
    : p = q
    := α
  in
  let eq3
    : q = ■ q refl
    := ru A a b q
  in
  let p■refl=q■refl
    : ■ p refl = ■ q refl
    :=
    trans²
      (a = b)
      (■ p refl) p q (■ q refl)
      eq1 eq2 eq3
  in
  idJ
    ( A
    , b
    , \z t → trans A a b z p t = trans A a b z q t
    , p■refl=q■refl
    , c
    , r
    )

#def whisker-l
  (A : U)
  (a b c : A)
  (r s : b = c)
  (p : a = b)
  (β : r = s)
  : trans A a b c p r = trans A a b c p s
  :=
  let ■ := trans A b b c in
  let eq1
    : ■ refl r = r
    := symm (b = c) r (■ refl r) (lu A b c r)
  in
  let eq2
    : r = s
    := β
  in
  let eq3
    : s = ■ refl s
    := lu A b c s
  in
  let refl■r=refl■s :=
    trans²
      (b = c)
      (■ refl r) r s (■ refl s)
      eq1 eq2 eq3
  in
  idJ²
    A
    b
    (\z t → trans A z b c t r = trans A z b c t s)
    refl■r=refl■s
    a
    p

#def horiz-comp
  (A : U)
  (a b c : A)
  (p q : a = b)
  (r s : b = c)
  (alpha : p = q)
  (beta : r = s)
  : trans A a b c p r = trans A a b c q s
  :=
    trans
      (a = c)
      (trans A a b c p r)
      (trans A a b c q r)
      (trans A a b c q s)
      (whisker-r A a b c p q alpha r)
      (whisker-l A a b c r s q beta)

#def horiz-comp'
  (A : U)
  (a b c : A)
  (p q : a = b)
  (r s : b = c)
  (alpha : p = q)
  (beta : r = s)
  : trans A a b c p r = trans A a b c q s
  :=
    trans
      (a = c)
      (trans A a b c p r)
      (trans A a b c p s)
      (trans A a b c q s)
      (whisker-l A a b c r s p beta)
      (whisker-r A a b c p q alpha s)

#def α⋆β=α■β
  (A : U)
  (a : A)
  (α β : Ω² A a)
  : horiz-comp A a a a refl refl refl refl α β
    = trans (a = a) refl refl refl α β
  :=
  let ■ := trans (Ω A a) refl refl refl in
  let ⋆ := horiz-comp A a a a refl refl refl refl in
  let _
    : ⋆ α β = ■ (■ refl α) (■ refl β)
    := refl
  in
  let ⟨refl■p⟩=p
    : (p : Ω² A a) → ■ refl p = p
    := \p →
    symm
      (Ω² A a)
      p
      (■ refl p)
      (lu (Ω A a) refl refl p)
  in
  let ⟨refl■α⟩■⟨refl■β⟩=α■⟨refl■β⟩
    : ■ (■ refl α) (■ refl β) = ■ α (■ refl β)
    :=
    whisker-r
      (Ω A a) refl refl refl
      (■ refl α) α
      (⟨refl■p⟩=p α)
      (■ refl β)
  in
  let α■⟨refl■β⟩=α■β
    : ■ α (■ refl β) = ■ α β
    :=
    whisker-l
      (Ω A a) refl refl refl
      (■ refl β) β
      α
      (⟨refl■p⟩=p β)
  in
  trans
    (Ω² A a)
    (■ (■ refl α) (■ refl β))
    (■ α (■ refl β))
    (■ α β)
    ⟨refl■α⟩■⟨refl■β⟩=α■⟨refl■β⟩
    α■⟨refl■β⟩=α■β

#def α⋆'β=β■α
  (A : U)
  (a : A)
  (α β : Ω² A a)
  : horiz-comp' A a a a refl refl refl refl α β
    = trans (a = a) refl refl refl β α
  :=
  let ■ := trans (Ω A a) refl refl refl in
  let ⋆' := horiz-comp' A a a a refl refl refl refl in
  let _
    : ⋆' α β = ■ (■ refl β) (■ refl α)
    := refl
  in
  let ⟨refl■p⟩=p
    : (p : Ω² A a) → ■ refl p = p
    := \p →
    symm
      (Ω² A a)
      p
      (■ refl p)
      (lu (Ω A a) refl refl p)
  in
  let ⟨refl■β⟩■⟨refl■α⟩=β■⟨refl■β⟩
    : ■ (■ refl β) (■ refl α) = ■ β (■ refl α)
    :=
    whisker-r
      (Ω A a) refl refl refl
      (■ refl β) β
      (⟨refl■p⟩=p β)
      (■ refl α)
  in
  let β■⟨refl■α⟩=β■α
    : ■ β (■ refl α) = ■ β α
    :=
    whisker-l
      (Ω A a) refl refl refl
      (■ refl α) α
      β
      (⟨refl■p⟩=p α)
  in
 trans
   (Ω² A a)
   (■ (■ refl β) (■ refl α))
   (■ β (■ refl α))
   (■ β α)
   ⟨refl■β⟩■⟨refl■α⟩=β■⟨refl■β⟩
   β■⟨refl■α⟩=β■α

#def α⋆β=α⋆'β
  (A : U)
  (a : A)
  (α β : Ω² A a)
  : horiz-comp A a a a refl refl refl refl α β
    = horiz-comp' A a a a refl refl refl refl α β
  :=
  let ⋆ := horiz-comp A a a a refl refl refl refl in
  let ⋆' := horiz-comp' A a a a refl refl refl refl in
  let refl⋆β=refl⋆'β
    : ⋆ refl β = ⋆' refl β
    :=
    idJ
      ( Ω A a
      , refl
      , \x p →
        horiz-comp  A a a a refl refl refl x refl p
        = horiz-comp' A a a a refl refl refl x refl p
      , refl
      , refl
      , β
      )

  in
  idJ
    ( Ω A a
    , refl
    , \x p →
      horiz-comp A a a a refl x refl refl p β
      = horiz-comp' A a a a refl x refl refl p β
    , refl⋆β=refl⋆'β
    , refl
    , α
    )

#def comm-■-Ω²
  (A : U)
  (a : A)
  (α β : Ω² A a)
  : trans (Ω A a) refl refl refl α β
    = trans (Ω A a) refl refl refl β α
  :=
  let ■ := trans (Ω A a) refl refl refl in
  let ⋆ := horiz-comp A a a a refl refl refl refl in
  let ⋆' := horiz-comp' A a a a refl refl refl refl in
  trans²
    (Ω² A a)
    (■ α β) (⋆ α β) (⋆' α β) (■ β α)
    (symm (Ω² A a) (⋆ α β) (■ α β) (α⋆β=α■β A a α β))
    (α⋆β=α⋆'β A a α β)
    (α⋆'β=β■α A a α β)