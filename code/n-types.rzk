#lang rzk-1

#def is-contr
  (A : U)
  : U
  := Σ (c : A) , (x : A) → c = x

#def is-prop
  (A : U)
  : U
  := (x y : A) → x = y

#def is-set
  (A : U)
  : U
  := (x y : A) → is-prop (x = y)

#def is-contr-Unit
  : is-contr Unit
  :=
  (unit , \_ → refl)

#def is-contr→is-prop
  (A : U)
  (A-is-contr : is-contr A)
  : is-prop A
  := \x y →
  let (c, ∀x.c=x) := A-is-contr in
  let x=c := symm A c x (∀x.c=x x) in
  let c=y := ∀x.c=x y in
  trans A x c y x=c c=y

