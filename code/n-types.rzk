#def is-prop→inhabited→is-contr
  (A : U)
  (A-is-prop : is-prop A)
  (a : A)
  : is-contr A
  := (a, \x → A-is-prop a x)

#def ⟨inhabited→is-contr⟩→is-prop
  (A : U)
  (inhabited→A-is-contr : A → is-contr A)
  : is-prop A
  := \x y →
  is-contr→is-prop A
    (inhabited→A-is-contr x)
    x y
