#lang rzk-1

#def prod
  (A : U)
  (B : U)
  : U
  := Sigma (_ : A) , B


#def homotopy
  (A B : U)
  (f g : A -> B)
  : U
  := (x : A) -> f x = g x

#def is-equiv
  (A B : U)
  (f : A -> B)
  : U
  :=
  prod
  ( Sigma ( r : B -> A)
    , homotopy A A (\ a -> r (f a)) (\x -> x))
  ( Sigma ( s : B -> A)
    , homotopy B B (\ b -> f (s b)) (\x -> x))

#def qinv
  (A B : U)
  (f : A -> B)
  : U
  :=
  Sigma (g : B -> A) ,
    prod
      (homotopy A A (\a -> g (f a)) (\x -> x))
      (homotopy B B (\a -> f (g a)) (\x -> x))

#def is-equiv-implies-qinv
  (A B : U)
  (f : A -> B)
  (f-is-equiv : is-equiv A B f)
  : qinv A B f
  :=
  let ((g, alpha), (h, beta)) := f-is-equiv in
  (g, (alpha, ?))
  -- wts: f ∘ g ∼ id[B]
  -- have: f ∘ h ∼ id[B]
  -- so: g ∼ g ∘ id ∼ g ∘ (f ∘ h) ∼ (g ∘ f) ∘ h ∼ id ∘ h ∼ h

#def Equiv
  (A B : U)
  : U
  := Sigma (f : A -> B) , is-equiv A B f
